+        # model always sees contrast-equalised radiographs. Low-contrast
+        # lesions (caries, periapical) are the intended beneficiaries.
+        dataset._transforms = T.Compose([LtClahe(), dataset._transforms])
+        print('[longtail] CLAHE enabled for %s' % image_set)
+
     return dataset
 
 
