+class LtClahe(object):
+    """CLAHE on the L channel of LAB; PIL in / PIL out. Gated by args.lt_clahe."""
+    def __init__(self, clip=2.0, grid=8):
+        import cv2
+        self._clahe = cv2.createCLAHE(clipLimit=clip, tileGridSize=(grid, grid))
+
+    def __call__(self, img, target=None):
+        import numpy as np, cv2
+        from PIL import Image
+        arr = np.asarray(img)
+        if arr.ndim == 2:
+            out = self._clahe.apply(arr)
+        else:
+            lab = cv2.cvtColor(arr, cv2.COLOR_RGB2LAB)
+            lab[..., 0] = self._clahe.apply(lab[..., 0])
+            out = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)
+        return Image.fromarray(out), target
+
+
 def build(image_set, args):
     root = Path(args.coco_path)
     mode = 'instances'
