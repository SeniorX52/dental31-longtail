+            matcher.lt_tau = _tau
+            matcher.lt_log_priors = _log_priors
+        if _lt_freq_dn:
+            from . import dn_components as _dnc
+            _w = torch.where(_counts > 0, _counts.clamp(min=1.0) ** -0.5,
+                             torch.zeros_like(_counts))
+            _dnc.LT_FREQ_DN_WEIGHTS = _w / _w.sum().clamp(min=1e-12)
+        print('[longtail] la_loss=%s la_cost=%s freq_dn=%s tau=%.2f (priors from %s)'
+              % (_lt_la_loss, _lt_la_cost, _lt_freq_dn, _tau, _tj))
     postprocessors = {'bbox': PostProcess(num_select=args.num_select, nms_iou_threshold=args.nms_iou_threshold)}
     if args.masks:
