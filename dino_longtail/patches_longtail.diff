+    _lt_la_cost = bool(getattr(args, 'lt_la_cost', False))
+    _lt_freq_dn = bool(getattr(args, 'lt_freq_dn', False))
+    if _lt_la_loss or _lt_la_cost or _lt_freq_dn:
+        import json as _json, os as _os
+        _tj = _os.path.join(args.coco_path, 'annotations', 'instances_train2017.json')
+        with open(_tj) as _f:
+            _annotations = _json.load(_f)['annotations']
+        _counts = torch.zeros(num_classes)
+        for _a in _annotations:
+            _c = int(_a['category_id'])
+            if 0 <= _c < num_classes:
+                _counts[_c] += 1
+        _p = _counts / _counts.sum().clamp(min=1)
+        # unused/absent classes get log-prior 0 (no adjustment) rather than -inf
+        _log_priors = torch.where(_counts > 0, _p.clamp(min=1e-12).log(),
+                                  torch.zeros_like(_p))
+        _tau = float(getattr(args, 'lt_tau', 1.0))
+        if _lt_la_loss:
