    given-names: Mostafa
    email: smart.darsh14@gmail.com
type: software
license: Apache-2.0
repository-code: "https://github.com/SeniorX52/dental31-longtail"
date-released: 2026-08-11
keywords:
  - medical imaging
  - dental radiography
  - instance segmentation
  - object detection
  - long-tailed recognition
  - evaluation integrity
  - dataset contamination
